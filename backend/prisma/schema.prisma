generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ADMIN
  EMPLEADO
}

enum Categoria {
  CHURRO
  DOCENA
  CAFE
  COMBO
  BEBIDA
  OTRO
}

enum UnidadMedida {
  GRAMO
  KILOGRAMO
  MILILITRO
  LITRO
  UNIDAD
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  MERCADO_PAGO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
  PERDIDA
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  CANCELADA
}

enum EstadoCompra {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

enum TipoCliente {
  MINORISTA
  MAYORISTA
}

enum EstadoProduccion {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

// ─── Modelos ─────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  nombre    String
  email     String    @unique
  password  String
  role      Role      @default(EMPLEADO)
  activo    Boolean   @default(true)
  deletedAt DateTime?

  ventas        Venta[]
  cajasAbiertas Caja[]     @relation("CajaApertura")
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("users")
}

model Producto {
  id              String    @id @default(uuid())
  nombre          String
  descripcion     String?
  precio          Decimal   @db.Decimal(10, 2)
  precioCompra    Decimal?  @db.Decimal(10, 2)
  precioMayorista Decimal?  @db.Decimal(10, 2)
  margen          Decimal?  @db.Decimal(5, 2)
  stockActual     Decimal   @default(0) @db.Decimal(10, 2)
  stockMinimo     Decimal   @default(0) @db.Decimal(10, 2)
  categoria       Categoria
  activo          Boolean   @default(true)
  deletedAt       DateTime?

  receta                Receta?
  ventaItems            VentaItem[]
  listaPrecioItems     ListaPrecioItem[]
  ordenProducciones    OrdenProduccion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("productos")
}

model Insumo {
  id            String       @id @default(uuid())
  nombre        String
  unidad        UnidadMedida
  stockActual   Decimal      @default(0) @db.Decimal(10, 3)
  stockMinimo   Decimal      @default(0) @db.Decimal(10, 3)
  costoUnitario Decimal      @default(0) @db.Decimal(10, 4)
  activo        Boolean      @default(true)
  deletedAt     DateTime?

  recetaItems      RecetaItem[]
  stockMovimientos StockMovimiento[]
  compraItems      CompraItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("insumos")
}

model Receta {
  id         String       @id @default(uuid())
  productoId String       @unique
  producto   Producto     @relation(fields: [productoId], references: [id])
  items      RecetaItem[]
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("recetas")
}

model RecetaItem {
  id       String  @id @default(uuid())
  recetaId String
  receta   Receta  @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  insumoId String
  insumo   Insumo  @relation(fields: [insumoId], references: [id])
  cantidad Decimal @db.Decimal(10, 3)

  @@unique([recetaId, insumoId])
  @@map("receta_items")
}

model Caja {
  id             String     @id @default(uuid())
  fechaApertura  DateTime   @default(now())
  fechaCierre    DateTime?
  montoInicial   Decimal    @db.Decimal(10, 2)
  montoFinalReal Decimal?   @db.Decimal(10, 2)
  montoEsperado  Decimal?   @db.Decimal(10, 2)
  diferencia     Decimal?   @db.Decimal(10, 2)
  estado         EstadoCaja @default(ABIERTA)
  observaciones  String?
  deletedAt      DateTime?

  abiertaPor  User?            @relation("CajaApertura", fields: [createdBy], references: [id])
  ventas      Venta[]
  movimientos MovimientoCaja[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedBy String?

  @@map("cajas")
}

model MovimientoCaja {
  id       String             @id @default(uuid())
  cajaId   String
  caja     Caja               @relation(fields: [cajaId], references: [id])
  tipo     TipoMovimientoCaja
  concepto String
  monto    Decimal            @db.Decimal(10, 2)
  fecha    DateTime           @default(now())

  @@map("movimientos_caja")
}

model Venta {
  id            String      @id @default(uuid())
  numero        String      @unique
  empleadoId    String
  empleado      User        @relation(fields: [empleadoId], references: [id])
  cajaId        String
  caja          Caja        @relation(fields: [cajaId], references: [id])
  clienteId     String?
  cliente       Cliente?    @relation(fields: [clienteId], references: [id])
  estado        EstadoVenta @default(COMPLETADA)
  items         VentaItem[]
  total         Decimal     @db.Decimal(10, 2)
  metodoPago    MetodoPago
  observaciones String?
  fecha         DateTime    @default(now())
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([empleadoId])
  @@index([clienteId])
  @@index([fecha])
  @@map("ventas")
}

model VentaItem {
  id         String   @id @default(uuid())
  ventaId    String
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  precioUnit Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)

  @@map("venta_items")
}

model Proveedor {
  id        String    @id @default(uuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  activo    Boolean   @default(true)
  deletedAt DateTime?
  compras   Compra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("proveedores")
}

model Cliente {
  id             String             @id @default(uuid())
  nombre         String
  cuit           String?            @unique
  contacto       String?
  telefono       String?
  email          String?
  direccion      String?
  tipo           TipoCliente        @default(MINORISTA)
  notas          String?
  activo         Boolean            @default(true)
  deletedAt      DateTime?
  listaPrecioId  String?
  listaPrecio    ListaPrecio?       @relation(fields: [listaPrecioId], references: [id])
  direcciones    DireccionEntrega[]
  ventas         Venta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("clientes")
}

model DireccionEntrega {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  alias     String
  direccion String
  barrio    String?
  ciudad    String?
  notas     String?
  activo    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("direcciones_entrega")
}

model ListaPrecio {
  id          String            @id @default(uuid())
  nombre      String
  descripcion String?
  activo      Boolean           @default(true)
  deletedAt   DateTime?
  items       ListaPrecioItem[]
  clientes    Cliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("listas_precio")
}

model ListaPrecioItem {
  id             String      @id @default(uuid())
  listaPrecioId String
  listaPrecio    ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto    @relation(fields: [productoId], references: [id])
  precio         Decimal     @db.Decimal(10, 2)

  @@unique([listaPrecioId, productoId])
  @@map("lista_precio_items")
}

model Compra {
  id            String       @id @default(uuid())
  numero        String       @unique
  proveedorId   String
  proveedor     Proveedor    @relation(fields: [proveedorId], references: [id])
  estado        EstadoCompra @default(RECIBIDA)
  items         CompraItem[]
  total         Decimal      @db.Decimal(10, 2)
  fecha         DateTime     @default(now())
  observaciones String?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([proveedorId])
  @@index([fecha])
  @@map("compras")
}

model CompraItem {
  id        String  @id @default(uuid())
  compraId  String
  compra    Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    Insumo  @relation(fields: [insumoId], references: [id])
  cantidad  Decimal @db.Decimal(10, 3)
  costoUnit Decimal @db.Decimal(10, 4)
  subtotal  Decimal @db.Decimal(10, 2)

  @@map("compra_items")
}

model StockMovimiento {
  id       String              @id @default(uuid())
  insumoId String
  insumo   Insumo              @relation(fields: [insumoId], references: [id])
  tipo     TipoMovimientoStock
  cantidad Decimal             @db.Decimal(10, 3)
  motivo   String?
  fecha    DateTime            @default(now())

  @@index([insumoId])
  @@index([fecha])
  @@map("stock_movimientos")
}

model OrdenProduccion {
  id             String            @id @default(uuid())
  numero         String            @unique
  productoId     String
  producto       Producto          @relation(fields: [productoId], references: [id])
  cantidad       Int
  estado         EstadoProduccion  @default(PENDIENTE)
  observaciones  String?
  fechaInicio    DateTime?
  fechaFin       DateTime?
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([productoId])
  @@index([estado])
  @@index([createdAt])
  @@map("ordenes_produccion")
}

model Secuencia {
  id          String  @id @default(uuid())
  prefijo     String  @unique
  valor       Int     @default(1)
  padding     Int     @default(4)
  descripcion String?

  @@map("secuencias")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  accion     String
  modelo     String
  registroId String?
  datos      Json?
  fecha      DateTime @default(now())

  @@index([modelo, registroId])
  @@index([fecha])
  @@map("audit_logs")
}
